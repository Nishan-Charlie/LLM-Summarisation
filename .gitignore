# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/

# Notebook checkpoints
.ipynb_checkpoints/

# OS
Thumbs.db
.DS_Store

# Keyword study: regenerable review pools (hundreds of MB)
data/kw/pools/
# Extra datasets: licences forbid redistribution; rebuild with scripts/kw_download_external.py
data/external/

# Keyword study: raw model outputs and per-summary scores (tens of MB each, grow with every run).
# The tables and figures built from them are kept.
results/kw/**/generations.jsonl
results/kw/**/scores.jsonl
# Run logs from scripts/kw_run_queue.ps1
results/kw/**/*.log
results/kw/**/*.log.err

# Reference papers: third-party PDFs, not ours to redistribute (~47 MB)
Papers/

# Zip bundles of files that are already in the repo
*.zip

# Paper draft (LaTeX source, figures, build output): not part of the code release.
# scripts/kw_paper_assets.py still writes its tables and figures here.
/paper/

# Local assistant tooling: editor/agent settings and agent planning notes.
# The study design and its amendments are kept in docs/design/.
/.claude/
/docs/superpowers/

# Secrets: API keys belong in environment variables, never in the repo
apiKeys.txt
*.key
.env
